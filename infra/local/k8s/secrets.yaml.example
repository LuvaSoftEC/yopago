apiVersion: v1
kind: Secret
metadata:
  name: yopago-secrets
  namespace: yopago
type: Opaque
# IMPORTANTE: Copia este archivo como secrets.yaml y reemplaza los valores
# cp k8s/secrets.yaml.example k8s/secrets.yaml
# secrets.yaml está en .gitignore y NO debe subirse al repositorio
stringData:
  POSTGRES_PASSWORD: "changeme"
  KEYCLOAK_ADMIN_PASSWORD: "changeme"
  KEYCLOAK_CLIENT_SECRET: "changeme"
  OPENAI_API_KEY: "sk-your-openai-key-here"
