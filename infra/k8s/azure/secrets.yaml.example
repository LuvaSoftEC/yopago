# ============================================================
# SECRETS DE REFERENCIA — NO SUBIR AL REPOSITORIO
# ============================================================
# En AKS los secrets se crean directamente desde el pipeline
# (ver infra/template/5_deploy_aks.yml). Este archivo documenta
# qué variables debes configurar en el Variable Group de Azure DevOps.
#
# Azure DevOps → Pipelines → Library → Variable Group
# Crea un grupo por entorno: yopago-dev / yopago-test / yopago-prod
#
# Variable Group: yopago-prod (ejemplo)
# ============================================================

# ── Base de datos (Azure Database for PostgreSQL) ────────────
# Secret name en K8s: yopago-db
#
# DB_USER            → usuario de la base de datos
#                      Ej: yopagoadmin
# POSTGRES_PASSWORD  → contraseña del usuario
#                      Ej: S3cur3P@ss!

# ── Keycloak admin ───────────────────────────────────────────
# Secret name en K8s: keycloak-admin
#
# KEYCLOAK_ADMIN_PASSWORD → contraseña del admin de Keycloak
#                           Ej: Adm1nS3cur3!

# ── Keycloak client ──────────────────────────────────────────
# Secret name en K8s: keycloak-client
#
# KEYCLOAK_CLIENT_SECRET → client secret del realm yopago
#                          Se obtiene desde Keycloak Admin Console:
#                          Clients → yopago-backend → Credentials

# ── Vision IA (OpenAI) ───────────────────────────────────────
# Secret name en K8s: vision-ia-openai
#
# OPENAI_API_KEY → clave de API de OpenAI
#                  Ej: sk-proj-xxxxxxxxxxxxxxxx

# ── Pipeline (Azure DevOps) ──────────────────────────────────
# Estas variables NO crean secrets en K8s, son para el pipeline:
#
# K8S_SERVICE_CONNECTION → nombre del Service Connection a AKS
#                          Azure DevOps → Project Settings → Service connections
# K8S_NAMESPACE          → namespace de K8s (ej: yopago)
# ACR_NAME               → nombre del Azure Container Registry (sin .azurecr.io)
# AZURE_SUBSCRIPTION     → nombre del Service Connection de suscripción Azure

# ── Conexión AKS (kubectl manual) ────────────────────────────
# Si necesitas crear los secrets manualmente (sin pipeline):
#
# kubectl create secret generic yopago-db \
#   --from-literal=DB_USER=yopagoadmin \
#   --from-literal=DB_PASS=S3cur3P@ss! \
#   -n yopago
#
# kubectl create secret generic keycloak-admin \
#   --from-literal=KEYCLOAK_ADMIN_PASSWORD=Adm1nS3cur3! \
#   -n yopago
#
# kubectl create secret generic keycloak-client \
#   --from-literal=KEYCLOAK_CLIENT_SECRET=<tu-client-secret> \
#   -n yopago
#
# kubectl create secret generic vision-ia-openai \
#   --from-literal=OPENAI_API_KEY=sk-proj-xxx \
#   -n yopago
